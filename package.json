{
  "name": "frigourmand",
  "productName": "Frigourmand",
  "version": "0.2.0",
  "description": "Trouver quoi cuisiner avec ce qu'on a dans le frigo et les placards.",
  "main": "main.js",
  "author": "Unyti",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "installeur": "electron-builder --win --x64 --publish never",
    "publier": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "fr.unyti.frigourmand",
    "productName": "Frigourmand",
    "copyright": "Unyti",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "donnees/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "./build/apres-empaquetage.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frigourmand",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ],
      "artifactName": "Frigourmand-Installation-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "unyti",
        "repo": "frigourmand",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unyti/frigourmand.git"
  }
}
